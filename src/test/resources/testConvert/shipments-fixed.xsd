                                    <xs:sequence>
                                        <xs:element name="baseRate">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="baseRateAmount" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="baseRateCurrency" minOccurs="1" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="surcharges" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="surcharge" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="type" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="surchargeAmount" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="surchargeDescription" minOccurs="0" type="xs:string"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="discounts" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="discount" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="discountCode" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="discountAmount" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="percentage" minOccurs="0" type="xs:string"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="totalAmount">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="totalAmountValue" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="totalAmountCurrency" minOccurs="1" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="tracking" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="currentLocation">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="facilityName" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="currentLocationCity" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="currentLocationState" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="currentLocationCountry" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="coordinates" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="latitude" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="longitude" minOccurs="0" type="xs:string"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="statusHistory" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="statusUpdate" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="status" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="timestamp" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="location" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="notes" minOccurs="0" type="xs:string"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="carrier" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="carrierInfo">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="carrierId" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="carrierName" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="serviceLevel" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="vehicleType" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="driver" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="driverId" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="driverName" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="contactNumber" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="vehicleNumber" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="insurance" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="isInsured" minOccurs="0" type="xs:string"/>
                                        <xs:element name="policyNumber" minOccurs="0" type="xs:string"/>
                                        <xs:element name="coverageAmount">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="coverageAmountValue" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="coverageAmountCurrency" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="provider" minOccurs="0" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="customsInfo" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="declarationNumber" minOccurs="0" type="xs:string"/>
                                        <xs:element name="customsValue">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="customsValueAmount" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="customsValueCurrency" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="dutyAmount" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="dutyAmountValue" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="dutyAmountCurrency" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="harmonizedCode" minOccurs="0" type="xs:string"/>
                                        <xs:element name="countryOfOrigin" minOccurs="0" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
