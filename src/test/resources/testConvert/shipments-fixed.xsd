<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="logistics-shipment-tracking-events">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="systemHeader">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="eventSchemaVersion" minOccurs="1" type="xs:string"/>
                            <xs:element name="recordCreatedTimestamp" minOccurs="1" type="xs:string"/>
                            <xs:element name="messageIdentifiers">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="messageId" minOccurs="1" type="xs:string"/>
                                        <xs:element name="correlationId" minOccurs="1" type="xs:string"/>
                                        <xs:element name="sourceSystem" minOccurs="1" type="xs:string"/>
                                        <xs:element name="eventSequenceNumber" minOccurs="1" type="xs:string"/>
                                        <xs:element name="publishTimestamp" minOccurs="1" type="xs:string"/>
                                        <xs:element name="retryCount" minOccurs="0" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="shipmentEvent">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="eventType" minOccurs="1" type="xs:string"/>
                            <xs:element name="eventOccurredAt" minOccurs="1" type="xs:string"/>
