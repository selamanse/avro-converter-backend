                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="trackingNumber" minOccurs="1" type="xs:string"/>
                                        <xs:element name="orderId" minOccurs="1" type="xs:string"/>
                                        <xs:element name="serviceType" minOccurs="1" type="xs:string"/>
                                        <xs:element name="shipmentStatus" minOccurs="1" type="xs:string"/>
                                        <xs:element name="estimatedDeliveryDate" minOccurs="0" type="xs:string"/>
                                        <xs:element name="actualDeliveryDate" minOccurs="0" type="xs:string"/>
                                        <xs:element name="priority" minOccurs="1" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="origin">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="originAddress">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="originName" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="originStreet" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="originCity" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="originState" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="originPostalCode" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="originCountry" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="originPhoneNumber" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="originEmail" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="facility" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="facilityId" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="facilityType" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="operatingHours" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="destination">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="destinationAddress">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="destinationName" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="destinationStreet" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="destinationCity" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="destinationState" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="destinationPostalCode" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="destinationCountry" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="destinationPhoneNumber" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="destinationEmail" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="deliveryInstructions" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="accessibilityInfo" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="hasElevator" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="floorNumber" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="requiresAppointment" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="package">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="dimensions">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="length" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="width" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="height" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="dimensionUnit" minOccurs="1" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="weight">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="weightValue" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="weightUnit" minOccurs="1" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="contents" minOccurs="0">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="description" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="quantity" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="declaredValue">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="declaredValueAmount" minOccurs="0" type="xs:string"/>
                                                                <xs:element name="declaredValueCurrency" minOccurs="0" type="xs:string"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="packaging">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="packageType" minOccurs="1" type="xs:string"/>
                                                    <xs:element name="isFragile" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="requiresSignature" minOccurs="0" type="xs:string"/>
                                                    <xs:element name="temperatureControlled" minOccurs="0" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="pricing" minOccurs="0">
